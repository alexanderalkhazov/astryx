# Copy to .env (git-ignored). Names only — never commit real values.
POSTGRES_PASSWORD=
# ES256 key ring "kid:base64-pkcs8[;kid2:...]"; generate: dotnet run --project apps/api -- --generate-jwt-key
JWT_SIGNING_KEYS=
AI_PROVIDER=Ollama
OLLAMA_MODEL=qwen3.5:0.8b
MARKET_DATA_PROVIDER=Fake
MARKET_DATA_API_KEY=
NEWS_PROVIDER=Fake
NEWS_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:5080
API_PORT=5080

# Real market data and Alpaca Paper trading (T-147, T-141): paper keys from the Alpaca dashboard. Never commit them.
# MARKET_DATA_PROVIDER=Alpaca
# MARKET_DATA_REQUESTS_PER_MINUTE=80
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Wraps users' stored Alpaca keys (AES-256-GCM envelope, §17.6). Generate: dotnet run --project apps/api -- --generate-credentials-key
CREDENTIALS_MASTER_KEYS=

# SEC EDGAR (T-174): SEC fair-access policy requires a contact in the User-Agent of every request.
SEC__USERAGENT=Astryx alexander410dev@gmail.com
