{
  "name": "astryx",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mobile": "pnpm --filter @astryx/mobile start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "api": "dotnet run --project apps/api",
    "api:test": "dotnet test Astryx.slnx",
    "api:gen": "node scripts/api-gen.mjs",
    "stack:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d --build",
    "stack:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down",
    "stack:logs": "docker compose -f infra/docker/docker-compose.yml --env-file .env logs -f api",
    "format": "prettier --write 'apps/mobile/**/*.{ts,tsx,js,mjs}' 'packages/**/*.{ts,tsx}' 'tests/load/*.{js,mjs}'",
    "format:check": "prettier --check 'apps/mobile/**/*.{ts,tsx,js,mjs}' 'packages/**/*.{ts,tsx}' 'tests/load/*.{js,mjs}'"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
