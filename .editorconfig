root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are generated: dotnet format and the analyzers leave them as emitted.
[**/Migrations/*.cs]
generated_code = true
